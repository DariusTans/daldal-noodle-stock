    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^29.0.1",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
