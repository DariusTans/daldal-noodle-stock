# Client (exposed to browser — public values only)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server only (Vercel Functions) — never prefix with VITE_
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL is not needed: the API talks to Supabase through supabase-js + RPC

# Server options
# Public site URL used in member invitation emails (defaults to https://$VERCEL_URL)
SITE_URL=https://daldal.example.com
# Set to "false" to stop signed-in users from creating new shops
ALLOW_SHOP_CREATION=true
